{
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "apps/v1"
    },
    "kind": {
      "const": "Deployment"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "replicas",
        "selector",
        "template"
      ],
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "selector": {
          "type": "object",
          "required": [
            "matchLabels"
          ],
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object"
            }
          }
        },
        "template": {
          "type": "object",
          "required": [
            "metadata",
            "spec"
          ],
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "type": "object",
              "required": [
                "labels"
              ],
              "additionalProperties": false,
              "properties": {
                "labels": {
                  "type": "object"
                }
              }
            },
            "spec": {
              "type": "object",
              "required": [
                "containers"
              ],
              "additionalProperties": false,
              "properties": {
                "containers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "image",
                      "securityContext"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "image": {
                        "type": "string"
                      },
                      "securityContext": {
                        "type": "object",
                        "required": [
                          "runAsNonRoot",
                          "allowPrivilegeEscalation"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "runAsNonRoot": {
                            "const": true
                          },
                          "allowPrivilegeEscalation": {
                            "const": false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
